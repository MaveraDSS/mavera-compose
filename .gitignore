.env
*.bak
# Databases.zip IS committed; a local unzip of it is not.
Databases/

# Generated by scripts/dokploy/generate-manifest.py. The per-service .env files
# hold RESOLVED secrets (DB_PASS, OKTA_*, CRYPTO_*), so they must never be
# committed -- regenerate them instead.
build/

# Python bytecode from the provisioning scripts.
__pycache__/
*.pyc
