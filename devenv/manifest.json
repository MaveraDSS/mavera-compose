    },
    {
      "name": "file-conversion",
      "repo": "mavera-file-conversion-service",
      "project": null,
      "port": 5221,
      "clusterIds": [ "mavera-file-conversion-service" ],
      "serviceSettingsNames": []
    },
    {
      "name": "ai-client-relevance-score",
      "repo": "mavera-ai-client-relevance-score",
      "project": null,
      "port": 5222,
      "clusterIds": [ "mavera-ai-client-relevance-score" ],
      "serviceSettingsNames": []
    },
    {
      "name": "ai-journalevents-classifier",
      "repo": "mavera-ai-journalevents-classifier",
      "project": null,
      "port": 5223,
      "clusterIds": [ "mavera-ai-journalevents-classifier" ],
      "serviceSettingsNames": []
    },
    {
      "name": "reflection",
      "repo": "mavera-reflection",
      "project": null,
      "port": 5224,
      "publicPrefix": "ReflectionService",
      "clusterIds": [],
      "serviceSettingsNames": [],
      "notes": "SignalR hub; the frontend opens a WebSocket to /ReflectionService/hubs/**, which is also an edge prefix."
    },
    {
      "name": "notification-service",
      "repo": "mavera-notification-service",
      "project": null,
      "port": 5225,
      "clusterIds": [],
      "serviceSettingsNames": [],
      "usesMessageBroker": true,
      "sendsMail": true,
      "notes": "Never point a local copy at the cluster broker: it would consume real notification messages and send real mail."
    },
    {
      "name": "background-task-scheduler",
      "repo": "mavera-background-task-schduler",
      "project": null,
      "port": 5226,
      "clusterIds": [],
      "serviceSettingsNames": [],
      "usesMessageBroker": true
    }
  ]
}
