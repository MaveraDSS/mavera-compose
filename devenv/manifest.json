{
  "_comment": "What exists: the frontend, the gateway (libertine) and every backend service. Ports are assigned here, not taken from launchSettings, because devenv sets ASPNETCORE_URLS itself. `project` is null until someone runs that service locally for the first time (DSS-5586) and fills it in.",

  "frontend": {
    "repo": "verisk-nordics-frontend",
    "workingDir": "apps/dss",
    "port": 3002,
    "command": [ "corepack", "pnpm", "exec", "next", "dev", "-p", "3002" ],
    "envFile": ".env",
    "healthPath": "/",
    "secrets": {
      "required": [
        "NEXTAUTH_SECRET",
        "NEXT_PUBLIC_CLIENT_SECRET",
        "NEXT_PUBLIC_PDFTRON_LICENSE_KEY",
        "NEXT_PUBLIC_ASSETS_BASE",
        "OKTA_CLIENT_SECRET"
      ],
      "optional": [
        "MONGO_BRIDGE_DEV_AUTH_TOKEN",
        "AZURE_AD_TENANT_ID",
        "AZURE_AD_CLIENT_ID",
        "AZURE_AD_CLIENT_SECRET"
      ]
    }
  },

  "gateway": {
    "repo": "mavera-libertine",
    "project": "LibertineWeb",
    "port": 5151,
    "configTemplate": "LibertineWeb/appsettings.json",
    "configOutput": "LibertineWeb/appsettings.Development.json",
    "healthPath": "/libertine/swagger/index.html",
    "edgeHealthPath": "/Vera/UserService/health",
    "edgeRoutes": [ "Vera", "connect", ".well-known", "ReflectionService", "identity-client" ],
    "publicClusters": [ "mavera-document-service" ],
    "serviceSettings": {
      "Monolith": { "ingress": "public" },
      "DocumentManagement": { "ingress": "public" },
      "MedicalAdvisorNetwork": { "path": "Vera/MedicalAdvisorNetwork/" }
    },
    "maxRequestBodySize": 524288000,
    "oktaInternalSecretKey": "OKTA_INTERNAL_SECRET"
  },

  "services": [
    {
      "name": "evaluation-service",
      "repo": "mavera-evaluation-service",
      "project": null,
      "port": 5201,
      "publicPrefix": "Vera/EvaluationService",
      "clusterIds": [ "mavera-evaluation-service" ],
      "serviceSettingsNames": [ "EvaluationService" ],
      "healthPath": "/Vera/EvaluationService/health",
      "runsMigrations": true,
      "usesMessageBroker": true
    },
    {
      "name": "user-service",
      "repo": "mavera-user-service",
      "project": null,
      "port": 5202,
      "publicPrefix": "Vera/UserService",
      "clusterIds": [ "mavera-user-service" ],
      "serviceSettingsNames": [ "UserService" ],
      "healthPath": "/Vera/UserService/health",
      "runsMigrations": true,
      "usesMessageBroker": true
    },
    {
      "name": "document-service",
      "repo": "mavera-document-service",
      "project": null,
      "port": 5203,
      "publicPrefix": "Vera/DocumentService",
      "clusterIds": [ "mavera-document-service" ],
      "serviceSettingsNames": [ "DocumentManagement" ],
      "healthPath": "/Vera/DocumentService/health",
      "runsMigrations": true,
      "usesMessageBroker": true
    },
    {
      "name": "medical-advisor-network",
      "repo": "mavera-medical-advisor-network",
      "project": null,
      "port": 5204,
      "publicPrefix": "Vera/MedicalAdvisorNetwork",
      "clusterIds": [ "mavera-medical-advisor-network" ],
      "serviceSettingsNames": [ "MedicalAdvisorNetwork" ],
      "healthPath": "/Vera/MedicalAdvisorNetwork/health"
    },
    {
      "name": "dashboard",
      "repo": "mavera-dashboard",
      "project": null,
      "port": 5205,
      "publicPrefix": "Vera/Dashboard",
      "clusterIds": [ "mavera-dashboard" ],
      "serviceSettingsNames": []
    },
    {
      "name": "caregivers",
      "repo": "mavera-caregivers",
      "project": null,
      "port": 5206,
      "clusterIds": [ "mavera-caregivers" ],
      "serviceSettingsNames": [],
      "runsMigrations": true
    },
    {
      "name": "identity-client",
      "repo": "mavera-identity-client",
      "project": null,
      "port": 5207,
      "publicPrefix": "identity-client",
      "clusterIds": [ "identity-client-service" ],
      "serviceSettingsNames": [],
      "notes": "The frontend calls /identity-client/** server-side during login, so this is also an edge prefix."
    },
    {
      "name": "enhanced-patient-view",
      "repo": "mavera-enhanced-patient-view",
      "project": null,
      "port": 5208,
      "clusterIds": [ "mavera-enhanced-patient-view" ],
      "serviceSettingsNames": []
    },
    {
      "name": "timeline",
      "repo": "mavera-ai-timeline",
      "project": null,
      "port": 5209,
      "clusterIds": [ "mavera-timeline-service" ],
      "serviceSettingsNames": [ "Timeline" ]
    },
    {
      "name": "ai-document-processor",
      "repo": "mavera-ai-document-processor",
      "project": null,
      "port": 5210,
      "clusterIds": [ "mavera-ai-document-processor" ],
      "serviceSettingsNames": [ "DocumentProcessor" ]
    },
    {
      "name": "ai-document-classifier",
      "repo": "mavera-ai-document-classifier",
      "project": null,
      "port": 5211,
      "clusterIds": [ "mavera-document-classifier" ],
      "serviceSettingsNames": []
    },
    {
      "name": "ai-document-summaries",
      "repo": "mavera-ai-document-summaries",
      "project": null,
      "port": 5212,
      "clusterIds": [ "mavera-document-summaries-service" ],
      "serviceSettingsNames": []
    },
    {
      "name": "fkassan",
      "repo": "mavera-fkassan-service",
      "project": null,
      "port": 5213,
      "clusterIds": [ "mavera-fkassan-service" ],
      "serviceSettingsNames": []
    },
    {
      "name": "audit",
      "repo": "mavera-audit",
      "project": null,
      "port": 5214,
      "clusterIds": [ "mavera-audit-service" ],
      "serviceSettingsNames": [],
      "usesMessageBroker": true
    },
    {
      "name": "pdf-generator",
      "repo": "mavera-pdf-generator-service",
      "project": null,
      "port": 5215,
      "clusterIds": [ "mavera-pdf-generator-service" ],
      "serviceSettingsNames": []
    },
    {
      "name": "ocr",
      "repo": "mavera-ocr",
      "project": null,
      "port": 5216,
      "clusterIds": [ "OcrService" ],
      "serviceSettingsNames": []
    },
    {
      "name": "ai-identitycheck-processor",
