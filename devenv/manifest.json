{
  "_comment": "What exists: the frontend, the gateway (libertine) and every backend service. Ports are assigned here, not taken from launchSettings, because devenv sets ASPNETCORE_URLS itself. A service needs `project` (its web .csproj) before it can run locally; `placeholders` says how the $Tokens in every committed appsettings.json get their values (see README, 'How a service config is rendered').",
  "gitBase": "https://github.com/MaveraDSS/",
  "frontend": {
    "repo": "verisk-nordics-frontend",
    "branch": "develop",
    "workingDir": "apps/dss",
    "port": 3002,
    "command": [
      "corepack",
      "pnpm",
      "exec",
      "next",
      "dev",
      "-p",
      "3002"
    ],
    "envFile": ".env",
    "healthPath": "/",
    "secrets": {
      "required": [
        "NEXTAUTH_SECRET",
        "NEXT_PUBLIC_CLIENT_SECRET",
        "NEXT_PUBLIC_PDFTRON_LICENSE_KEY",
        "NEXT_PUBLIC_ASSETS_BASE",
        "OKTA_CLIENT_SECRET"
      ],
      "optional": [
        "MONGO_BRIDGE_DEV_AUTH_TOKEN",
        "AZURE_AD_TENANT_ID",
        "AZURE_AD_CLIENT_ID",
        "AZURE_AD_CLIENT_SECRET"
      ]
    }
  },
  "gateway": {
    "repo": "mavera-libertine",
    "branch": "develop",
    "project": "LibertineWeb",
    "port": 5151,
    "configTemplate": "LibertineWeb/appsettings.json",
    "configOutput": "LibertineWeb/appsettings.Development.json",
    "healthPath": "/libertine/swagger/index.html",
    "edgeHealthPath": "/Vera/UserService/health",
    "edgeRoutes": [
      "Vera",
      "connect",
      ".well-known",
      "ReflectionService",
      "identity-client"
    ],
    "publicClusters": [
      "mavera-document-service"
    ],
    "serviceSettings": {
      "Monolith": {
        "ingress": "public"
      },
      "DocumentManagement": {
        "ingress": "public"
      },
      "MedicalAdvisorNetwork": {
        "path": "Vera/MedicalAdvisorNetwork/"
      }
    },
    "maxRequestBodySize": 524288000,
    "oktaInternalSecretKey": "OKTA_INTERNAL_SECRET"
  },
  "placeholders": {
    "_comment": "Layers, later wins: x-placeholders defaults from `source`, environments/<env>.json placeholders, `local`, computed (ServiceSettings_ENV, Tracing_Connection_String), then `secrets` from secrets.json. `hosts` re-points cluster hostnames: @identity/@internal/@public are the environment's URLs, anything else is literal. A service can override single placeholders with its own `placeholders` map (e.g. CacheType: inmemory for a service that supports it).",
    "source": "../docker-compose.yml",
    "local": {
      "MessageBroker_Username": "mavera",
      "MessageBroker_Password": "mavera",
      "MessageBroker_VirtualHost": "/",
      "RedisInstance": "localhost",
      "RedisPort": "6379",
      "CacheType": "redis",
      "Log_Level": "Information",
      "Log_IncludeScopes": "false",
      "MailSettings_MailEnvironment": "Development",
      "MailSettings_BccMonitoringEnabled": "false",
      "ServiceSettings_Services_WebhookSubscriptionService": "mavera-client-webhook"
    },
    "secrets": {
      "ConnectionStrings_DB_Pass": {
        "key": "DB_PASSWORD",
        "required": true
      },
      "Okta_InternalServices_Secret": {
        "key": "OKTA_INTERNAL_SECRET",
        "required": true
      },
      "CryptoSettings_CryptoIV": {
        "key": "CRYPTO_IV"
      },
      "CryptoSettings_CryptoKey": {
        "key": "CRYPTO_KEY"
      },
      "SmbSettings_Server": {
        "key": "SMB_SERVER"
      },
      "SmbSettings_Share": {
        "key": "SMB_SHARE"
      },
      "SmbSettings_UserName": {
        "key": "SMB_USERNAME"
      },
      "SmbSettings_Password": {
        "key": "SMB_PASSWORD"
      },
      "BucketProviderUrl": {
        "key": "S3_ENDPOINT_URL"
      },
      "BucketProviderKey": {
        "key": "S3_ACCESS_KEY_ID"
      },
      "BucketProviderSecret": {
        "key": "S3_SECRET_ACCESS_KEY"
      },
      "MailSettings_ApiKey": {
        "key": "MAIL_API_KEY"
      },
      "MailSettings_ApiKeyId": {
        "key": "MAIL_API_KEY_ID"
      },
      "SmsSettings_UserName": {
        "key": "SMS_USERNAME"
      },
      "SmsSettings_Password": {
        "key": "SMS_PASSWORD"
      },
      "InternalServicesSettings_Secret": {
        "key": "INTERNAL_SERVICES_SECRET"
      },
      "InternalServicesSettings_SystemAccountUserId": {
        "key": "SYSTEM_ACCOUNT_USER_ID"
      },
      "Okta_Integration_ClientId": {
        "key": "OKTA_INTEGRATION_CLIENT_ID"
      },
      "Bucket_DocumentsBucketName": {
        "key": "S3_BUCKET_NAME"
      },
      "Bucket_Region": {
        "key": "S3_REGION"
      },
      "MailSettings_TestingEmailAddress": {
        "key": "MAIL_TEST_ADDRESS"
      }
    },
    "hosts": {
      "rabbitmq.rabbitmq.svc.cluster.local": "localhost",
      "mavera-identity-server": "@identity",
      "mavera-translation-service": "@internal"
    }
  },
  "services": [
    {
      "name": "evaluation-service",
      "repo": "mavera-evaluation-service",
      "project": "EvaluationService/EvaluationService.csproj",
      "port": 5201,
      "publicPrefix": "Vera/EvaluationService",
      "clusterIds": [
        "mavera-evaluation-service"
      ],
      "serviceSettingsNames": [
        "EvaluationService"
      ],
      "healthPath": "/Vera/EvaluationService/health",
      "migrations": "dbup",
      "migrationsFolder": "_Migrations",
      "migrationsJournal": "SchemaVersions",
      "connectionStringName": "MaveraContext",
      "usesMessageBroker": true,
      "requiresX64": true,
      "notes": "Carries x64-only Service Fabric remoting assemblies (via Vera.Common / Mavera.Access.*): on an arm64 Mac devenv starts it with the x64 .NET host."
    },
    {
      "name": "user-service",
      "repo": "mavera-user-service",
      "project": "UserService.Api/UserService.Api.csproj",
      "port": 5202,
      "publicPrefix": "Vera/UserService",
      "clusterIds": [
        "mavera-user-service"
      ],
      "serviceSettingsNames": [
        "UserService"
      ],
      "healthPath": "/Vera/UserService/health",
      "migrations": "dbup",
      "migrationsFolder": "_Migrations",
      "migrationsJournal": "UserServiceSchemaVersions",
      "connectionStringName": "MaveraContext",
      "usesMessageBroker": true,
      "requiresX64": true,
      "notes": "Carries x64-only Service Fabric remoting assemblies (via Vera.Common / Mavera.Access.*): on an arm64 Mac devenv starts it with the x64 .NET host."
    },
    {
      "name": "document-service",
      "repo": "mavera-document-service",
      "project": "Mavera.DocumentService/DocumentService/DocumentService.csproj",
      "port": 5203,
      "publicPrefix": "Vera/DocumentService",
      "clusterIds": [
        "mavera-document-service"
      ],
      "serviceSettingsNames": [
        "DocumentManagement"
      ],
      "healthPath": "/Vera/DocumentService/health",
      "optionalHealthChecks": {
        "s3": {
          "secrets": ["S3_ENDPOINT_URL", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "S3_BUCKET_NAME"],
          "note": "object storage not configured (DSS-5604), so documents cannot be opened or uploaded through the local document-service; everything else works"
        }
      },
      "migrations": "dbup",
      "migrationsFolder": "_Migrations",
      "migrationsJournal": "DocumentServiceSchemaVersions",
      "connectionStringName": "MaveraContext",
      "usesMessageBroker": true,
      "requiresX64": true,
      "notes": "Carries x64-only Service Fabric assemblies (System.Fabric via Vera.Common): on an arm64 Mac devenv starts it with the x64 .NET host."
    },
    {
      "name": "medical-advisor-network",
      "repo": "mavera-medical-advisor-network",
      "project": "Mavera.MedicalAdvisorNetwork.Api/Mavera.MedicalAdvisorNetwork.Api.csproj",
      "port": 5204,
      "publicPrefix": "Vera/MedicalAdvisorNetwork",
      "remotePath": "Vera/MedicalAdvisorNetwork",
      "clusterIds": [
        "mavera-medical-advisor-network"
