      "clusterIds": [ "mavera-identity-check" ],
      "serviceSettingsNames": []
    },
    {
      "name": "kuralink",
      "repo": "mavera-kuralink",
      "project": null,
      "port": 5218,
      "clusterIds": [ "mavera-kuralink" ],
      "serviceSettingsNames": []
    },
    {
      "name": "news-manager",
      "repo": "mavera-news-manager",
      "project": null,
      "port": 5219,
      "clusterIds": [ "mavera-news-manager" ],
      "serviceSettingsNames": []
    },
    {
      "name": "storage-service",
