# =============================================================================
# Mavera compose stack — configuration
#
# Local use:  cp .env.example .env  and edit.
# Dokploy:    paste these into the app's Environment tab; Dokploy writes .env.
# =============================================================================

# --- Source (required for building) ------------------------------------------
# Fine-grained PAT with read-only Contents access to the 29 MaveraDSS repos.
# NOTE: this token is embedded in the build-context URL and is recorded in
# BuildKit history. Use a short-lived token and rotate it.
GH_PAT=

# The branch built for every service repo that has it.
BRANCH=release/v.be-2026-04-01

# Three repos have not cut that branch -- mavera-identity-server,
# mavera-news-manager and mavera-audit -- so their build contexts read this
# knob instead. Re-check before bumping BRANCH (command in docker-compose.yml
# header) and move any repo that has caught up back onto BRANCH.
BRANCH_FALLBACK=develop

# --- Image naming ------------------------------------------------------------
# Built images are tagged with these so the same reference can later be PULLED
# from ACR instead of built (see README "Switching to pull-only").
ACR=mavera.azurecr.io
ACR_ENV=dev
# Docker tags cannot contain '/', so the branch name is dashed here.
TAG=release-v.be-2026-04-01

# --- Which services to start -------------------------------------------------
# Empty = infrastructure only. Options: platform, evaluation, documents, ai, all
# Cap concurrent builds. 29 parallel `dotnet build` runs will OOM a 16 GB VM.
COMPOSE_PARALLEL_LIMIT=2

COMPOSE_PROFILES=

# --- Public hostnames (Traefik / Dokploy) ------------------------------------
# Scheme advertised in public URLs. Use http for a bare-IP or tunnelled smoke
# test; switch to https once the domains have certificates. This feeds
# IdentityServer_IssuerUri (the `iss` claim in every token), so a mismatch
# between this and how clients actually reach the server breaks OIDC.
PUBLIC_SCHEME=http

# MUST be two DIFFERENT hostnames -- each becomes a Traefik Host() rule, so the
# same value in both makes the two routers collide.
# Do NOT use the EC2 public DNS name (ec2-...compute.amazonaws.com):
#   - you cannot create subdomains under it, so you cannot get two names
#   - Let's Encrypt refuses to issue certificates for it (policy)
#   - it changes on stop/start without an Elastic IP, invalidating every token
# Use a domain you own (with an Elastic IP), or for a throwaway test a wildcard
# DNS service: mavera.<ip-with-dashes>.sslip.io / identity.<ip>.sslip.io
GATEWAY_HOST=mavera.localhost
IDENTITY_HOST=identity.localhost

# --- SQL Server --------------------------------------------------------------
# Point DB_SERVER at a populated dev instance if you need the services that
# have no EF migrations (see README). Password must not contain '$'.
DB_SERVER=sqlserver
DB_USER=sa
# Cap SQL Server RAM in MB; raise on a bigger VM.
# Keep comments on their own line -- a trailing comment after a value is
# kept as part of the value by env-file parsers.
# Overrides the SQL Server image. Referenced by `sqlserver` and `mssql-init`,
# which reuses it for sqlcmd. Leave blank to take the default below.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

MSSQL_MEMORY_LIMIT_MB=2048
DB_PASS=Mavera_L0cal_Dev

# --- Database restore --------------------------------------------------------
# The three data-bearing databases (vera-dev02, vera-caregivers-dev02,
# vera-identity-dev02) are restored automatically on first deploy from the
# backups in Databases.zip. The restore is idempotent: a database that already
# exists is left alone, so redeploys cost nothing.
#
# Set false to skip the restore entirely -- the stack still deploys, and the
# services that read those databases fail on their first query instead.
SQL_RESTORE_ENABLED=true

# DESTRUCTIVE. true re-restores over the existing databases on EVERY deploy,
# discarding anything written since. Use it to refresh dev data from a newer
# Databases.zip, then set it back to false.
#
# With SQL_PROJECTS set this is N times as destructive: every project's copy is
# re-restored in the same deploy, not just one.
SQL_RESTORE_FORCE=false

# --- Per-project SQL Server catalogs ------------------------------------------
# One server, but one complete set of the seven catalogs per project, named
# <prefix><catalog>, plus a login that can reach that set and nothing else.
#
# INFRA STACK ONLY. Comma-separated, two entry shapes:
#
#   prefix                 the catalogs are created and restored; sa keeps
#                          access. Isolation is real but conventional -- any
#                          project holding the sa password can reach any set.
#
#   prefix:login:password  a login that OWNS those seven catalogs, so it is dbo
#                          in each (EF Core migrations need the DDL rights) and
#                          is denied everything else: it cannot connect to, or
#                          even enumerate, another project's catalogs. Give the
#                          pair to the project as its DB_USER/DB_PASS and SQL
#                          Server enforces the boundary.
#
# FIELD 1 IS THE PREFIX VERBATIM, not a project name -- it is the identical
# string the app stack puts in DB_PREFIX, so the two halves cannot drift by a
# trailing hyphen. Convention is "<project>-". An empty first field means the
# unprefixed set, i.e. the names this stack used before projects existed.
#
# Prefixes are lowercase a-z 0-9 _ - , start with a letter or digit, and are at
# most 38 characters. That ceiling is Mongo's, not SQL Server's: the same
# DB_PREFIX names the Mongo databases, Mongo caps a database name at 63, and
# the longest is journalevents-classifier. Passwords must not contain ',' (the
# list separator) or '$' (Compose interpolation and envsubst); ':' is fine.
#
# CHECK_POLICY is ON, so a password Windows/SQL Server considers weak fails the
# deploy with a clear error rather than creating a soft login.
#
# Example -- two projects, each with its own credentials:
# SQL_PROJECTS=alpha-:alpha_app:Alpha_Pw_1,beta-:beta_app:Beta_Pw_1
SQL_PROJECTS=

# INFRA STACK ONLY. A prefixed restore cannot repoint a 3-part reference inside
# the data ([vera-dev02].dbo.X in a view, proc or synonym), because SQL Server
# has no way to alias a database name. mssql-restore.sh audits for these after
# every prefixed restore and prints an [xdb] line per hit. true makes a hit fail
# the deploy instead of warning. Expect zero hits for the three catalogs shipped
# here -- they are three different applications' data.
SQL_CROSSDB_STRICT=false

# INFRA STACK ONLY. false skips the unprefixed pass entirely, for a server where
# every project is prefixed and you do not want a spare ~450 MB copy of the
# restored data sitting under the original names.
SQL_DEFAULT_CATALOGS=true

# --- MongoDB -----------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=mavera_mongo_dev
MONGO_USER=mavera
MONGO_PASS=mavera

# Per-project databases. Same shape as SQL_PROJECTS above, same prefix rules,
# and the prefix MUST be the same string for a given project -- one DB_PREFIX
# in the app stack names both the SQL catalogs and the Mongo databases.
#
# INFRA STACK ONLY. Comma-separated, two entry shapes:
#
#   prefix                 the eleven databases are created and MONGO_USER
#                          above is granted readWrite on them. Conventional.
#
#   prefix:user:password   a dedicated user with readWrite on THOSE eleven and
#                          nothing else -- no readWriteAnyDatabase, no role on
#                          admin. Since MongoDB 4.0.5 listDatabases filters to
#                          what the caller can reach, so it cannot even learn
#                          another project's database names.
#
# The user is created in `admin` because the rendered connection string has no
# database in its path. That makes usernames GLOBAL: two projects cannot share
# one, and mongo-init rejects a duplicate rather than letting the second entry
# silently replace the first project's grants.
#
# Example -- the same two projects:
# MONGO_PROJECTS=alpha-:alpha_mongo:Alpha_Mg_1,beta-:beta_mongo:Beta_Mg_1
MONGO_PROJECTS=

# --- RabbitMQ ----------------------------------------------------------------
# The broker admin. Also the account rabbitmq-init authenticates with, and the
# one the management UI on port 15672 is reached by.
RABBITMQ_USER=mavera
RABBITMQ_PASS=mavera

# Per-project virtual hosts. One broker, but a vhost is a complete namespace:
# exchanges, queues, bindings and messages in one are invisible from another, so
# services in a project only exchange messages with each other.
#
# INFRA STACK ONLY. Comma-separated, two entry shapes:
#
#   name                 RABBITMQ_USER above gets full rights on the vhost.
#                        Isolation is real but conventional -- any project that
#                        holds the admin password can point at any vhost.
#
#   name:user:password   a dedicated user with rights on THAT vhost only and no
#                        management access. Give the pair to the project as its
#                        RABBITMQ_USER/RABBITMQ_PASS and the broker enforces the
#                        boundary: it cannot reach another project's vhost even
#                        if misconfigured to try.
#
# Names are limited to A-Z a-z 0-9 . _ - (they go into an API path unencoded).
# Empty means every project stays on "/", which is the pre-existing behaviour.
#
# Example -- two projects, each with its own credentials:
# RABBITMQ_VHOSTS=mavera-prod:mavera-prod:prod_broker_pw,mavera-staging:mavera-staging:staging_broker_pw
RABBITMQ_VHOSTS=

# APP STACK ONLY. Which of the vhosts above these 29 services use. It must
# already exist -- the broker does not create one on connect, so a name that
# rabbitmq-init never made gives every service ACCESS_REFUSED on startup.
# Defaults to "/" so an existing single-project deployment is unaffected.
RABBITMQ_VHOST=

# --- Which project this app stack is -------------------------------------------
# APP STACK ONLY. Prepended to the seven SQL catalog names and the eleven Mongo
# database names. It must match field 1 of a SQL_PROJECTS and a MONGO_PROJECTS
# entry exactly -- neither server creates a set on connect, so an unlisted
# prefix gives "Cannot open database" and "Authentication failed" on every
# service rather than an empty database. mssql-init and mongo-init each print
# the exact DB_PREFIX= line to paste here. Empty is the pre-existing
# single-project set.
DB_PREFIX=

# APP STACK ONLY. Which Redis these 29 services use. Empty means `redis`, the
# shared instance in the infra stack, which is the pre-existing behaviour.
# Set it to <prefix>redis AND add `project-redis` to COMPOSE_PROFILES to bring
# up this stack's own instance instead -- separate process, separate AOF file,
# separate keyspace, its own volume.
#
# Never point two stacks at the same name, and never call the container `redis`:
# two containers claiming that alias on dokploy-network make Docker's DNS
# round-robin between them. See README "Per-project Redis".
#
#   REDIS_HOST=alpha-redis
#   COMPOSE_PROFILES=all,project-redis
REDIS_HOST=

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_USER=mavera
MINIO_PASS=mavera_minio_dev
BUCKET_ASSETS=mavera-assets
BUCKET_DOCUMENTS=mavera-documents
BUCKET_REGION=us-east-1

# --- Seq (log/trace UI; admin login) -----------------------------------------
SEQ_ADMIN_PASS=mavera_seq_dev

# --- General -----------------------------------------------------------------
ENV_NAME=dokploy
LOG_LEVEL=Information
CACHE_TYPE=redis
IDP_MARKETS=Sweden

# --- Secrets: blank by default; dependent flows will not work ----------------
IDENTITY_SECRET_KEY=
IDENTITY_MEMBERSHIP_HASH=
# Still required: the three repos on BRANCH_FALLBACK (identity-server,
# news-manager, audit) read the pre-Okta shared secret.
INTERNAL_SERVICES_SECRET=
SYSTEM_ACCOUNT_USER_ID=
CRYPTO_IV=
CRYPTO_KEY=
APRYSE_LICENSE_KEY=
APRYSE_LICENSE_KEY_OCR=

# --- Okta: REQUIRED for the `platform` profile -------------------------------
# On release/v.be-2026-04-01 service-to-service auth is Okta client-credentials,
# not the old shared secret: ~24 services build their discovery document as
# https://$OKTA_DOMAIN/oauth2/$OKTA_AUTH_SERVER_ID and exchange
# OKTA_INTERNAL_CLIENT_ID / OKTA_INTERNAL_SECRET for an `internalapi` token.
# Leave these blank and the infrastructure profile still comes up, but every
# cross-service call in `platform` fails token acquisition.
OKTA_DOMAIN=
OKTA_AUTH_SERVER_ID=
OKTA_INTERNAL_CLIENT_ID=
OKTA_INTERNAL_SECRET=
OKTA_AUDIENCE=api
OKTA_AUDIENCES=api

# Okta, optional (user provisioning and event hooks)
OKTA_GROUPS=
OKTA_EVENT_HOOK_SECRET=
OKTA_PROVISIONING_BASE_URL=
OKTA_PROVISIONING_CLIENT_ID=
OKTA_PROVISIONING_PRIVATE_KEY=
OKTA_PROVISIONING_PUBLIC_KEY_ID=

MAIL_API_KEY=
MAIL_API_KEY_ID=
MAIL_TEST_ADDRESS=
SMS_USERNAME=
SMS_PASSWORD=
SMB_SERVER=
SMB_SHARE=
SMB_USERNAME=
SMB_PASSWORD=
KURALINK_API_ROOT=
KURALINK_API_KEY=
TEAMS_WEBHOOK=

# --- External AI model endpoints (separate Python services) ------------------
AI_DOCUMENT_PROCESSOR_URL=
AI_DOCUMENT_CLASSIFICATION_URL=
AI_SUMMARIES_URL=
AI_FKASSAN_URL=
AI_OCR_URL=
AI_RELEVANCE_URL=
AI_EVENT_PREDICT_URL=
# Bare host (no scheme, no path): libertine proxies to http://$AI_IDP2_HOST/
AI_IDP2_HOST=

