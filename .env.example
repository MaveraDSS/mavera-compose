# =============================================================================
# Mavera compose stack — configuration
#
# Local use:  cp .env.example .env  and edit.
# Dokploy:    paste these into the app's Environment tab; Dokploy writes .env.
# =============================================================================

# --- Source (required for building) ------------------------------------------
# Fine-grained PAT with read-only Contents access to the 29 MaveraDSS repos.
# NOTE: this token is embedded in the build-context URL and is recorded in
# BuildKit history. Use a short-lived token and rotate it.
GH_PAT=
BRANCH=develop

# --- Image naming ------------------------------------------------------------
# Built images are tagged with these so the same reference can later be PULLED
# from ACR instead of built (see README "Switching to pull-only").
ACR=mavera.azurecr.io
ACR_ENV=dev
TAG=develop

# --- Which services to start -------------------------------------------------
# Empty = infrastructure only. Options: platform, evaluation, documents, ai, all
# Cap concurrent builds. 29 parallel `dotnet build` runs will OOM a 16 GB VM.
COMPOSE_PARALLEL_LIMIT=2

COMPOSE_PROFILES=

# --- Public hostnames (Traefik / Dokploy) ------------------------------------
# Scheme advertised in public URLs. Use http for a bare-IP or tunnelled smoke
# test; switch to https once the domains have certificates. This feeds
# IdentityServer_IssuerUri (the `iss` claim in every token), so a mismatch
# between this and how clients actually reach the server breaks OIDC.
PUBLIC_SCHEME=http

# MUST be two DIFFERENT hostnames -- each becomes a Traefik Host() rule, so the
# same value in both makes the two routers collide.
# Do NOT use the EC2 public DNS name (ec2-...compute.amazonaws.com):
#   - you cannot create subdomains under it, so you cannot get two names
#   - Let's Encrypt refuses to issue certificates for it (policy)
#   - it changes on stop/start without an Elastic IP, invalidating every token
# Use a domain you own (with an Elastic IP), or for a throwaway test a wildcard
# DNS service: mavera.<ip-with-dashes>.sslip.io / identity.<ip>.sslip.io
GATEWAY_HOST=mavera.localhost
IDENTITY_HOST=identity.localhost

# --- SQL Server --------------------------------------------------------------
# Point DB_SERVER at a populated dev instance if you need the services that
# have no EF migrations (see README). Password must not contain '$'.
DB_SERVER=sqlserver
DB_USER=sa
MSSQL_MEMORY_LIMIT_MB=2048          # cap SQL Server RAM (MB); raise on a bigger VM
DB_PASS=Mavera_L0cal_Dev

# --- MongoDB -----------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=mavera_mongo_dev
MONGO_USER=mavera
MONGO_PASS=mavera

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=mavera
RABBITMQ_PASS=mavera

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_USER=mavera
MINIO_PASS=mavera_minio_dev
BUCKET_ASSETS=mavera-assets
BUCKET_DOCUMENTS=mavera-documents
BUCKET_REGION=us-east-1

# --- Seq (log/trace UI; admin login) -----------------------------------------
SEQ_ADMIN_PASS=mavera_seq_dev

# --- General -----------------------------------------------------------------
ENV_NAME=dokploy
LOG_LEVEL=Information
CACHE_TYPE=redis
IDP_MARKETS=Sweden

# --- Secrets: blank by default; dependent flows will not work ----------------
IDENTITY_SECRET_KEY=
IDENTITY_MEMBERSHIP_HASH=
INTERNAL_SERVICES_SECRET=
SYSTEM_ACCOUNT_USER_ID=
CRYPTO_IV=
CRYPTO_KEY=
APRYSE_LICENSE_KEY=
APRYSE_LICENSE_KEY_OCR=

OKTA_DOMAIN=
OKTA_AUTH_SERVER_ID=
OKTA_AUDIENCE=api
OKTA_AUDIENCES=api
OKTA_GROUPS=
OKTA_EVENT_HOOK_SECRET=
OKTA_INTERNAL_CLIENT_ID=
OKTA_INTERNAL_SECRET=
OKTA_PROVISIONING_BASE_URL=
OKTA_PROVISIONING_CLIENT_ID=
OKTA_PROVISIONING_PRIVATE_KEY=
OKTA_PROVISIONING_PUBLIC_KEY_ID=

MAIL_API_KEY=
MAIL_API_KEY_ID=
MAIL_TEST_ADDRESS=
SMS_USERNAME=
SMS_PASSWORD=
SMB_SERVER=
SMB_SHARE=
SMB_USERNAME=
SMB_PASSWORD=
KURALINK_API_ROOT=
KURALINK_API_KEY=
TEAMS_WEBHOOK=

# --- External AI model endpoints (separate Python services) ------------------
AI_DOCUMENT_PROCESSOR_URL=
AI_DOCUMENT_CLASSIFICATION_URL=
AI_SUMMARIES_URL=
AI_FKASSAN_URL=
AI_OCR_URL=
AI_RELEVANCE_URL=
AI_EVENT_PREDICT_URL=

